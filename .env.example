# Root environment variables for docker-compose

# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Add other LLM provider keys
# OPENAI_API_KEY=your_openai_key
# MISTRAL_API_KEY=your_mistral_key

# ArbitrageAuto AI - Database
POSTGRES_DB=arbitrage_db
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_password
DATABASE_URL=postgresql://nexus:nexus_password@localhost:5432/arbitrage_db

# ArbitrageAuto AI - Service
ARBITRAGE_SERVICE_PORT=4000
USE_MOCK_SCRAPER=true
PROXY_LIST=
SCRAPER_MAX_BROWSERS=3
SCRAPER_RATE_LIMIT_MIN_MS=2000
SCRAPER_RATE_LIMIT_MAX_MS=5000
